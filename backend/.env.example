# Database configuration
# In production on Render, DATABASE_URL is injected automatically by the Postgres Blueprint
DATABASE_URL=sqlite:///./app/data/subsight.db

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudflare R2 Storage (Optional - falls back to local disk if unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=subsight-uploads
R2_PUBLIC_BASE_URL=
